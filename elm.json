{
    "type": "package",
    "name": "passiomatic/elm-zak",
    "summary": "Zak, a small embeddable scripting language interpreter",
    "license": "MIT",
    "version": "1.0.0",
    "exposed-modules": [
        "Zak.AST",
        "Zak.Debug",
        "Zak.Globals",
        "Zak.Helpers",
        "Zak.Interpreter",
        "Zak.Lexer",
        "Zak.Math",
        "Zak.Parser",
        "Zak.Random",
        "Zak.Runtime",
        "Zak.String",
        "Zak.Thread"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "elm/core": "1.0.5 <= v < 2.0.0",
        "elm/parser": "1.1.0 <= v < 2.0.0",
        "elm/random": "1.0.0 <= v < 2.0.0",
        "rtfeldman/elm-hex": "1.0.0 <= v < 2.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.2.1 <= v < 3.0.0"
    }
}
