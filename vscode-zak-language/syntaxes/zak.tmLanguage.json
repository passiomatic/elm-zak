{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zak",
  "scopeName": "source.zak",
  "fileTypes": ["zak"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#language-constants" },
    { "include": "#storage-keywords" },
    { "include": "#control-keywords" },
    { "include": "#word-operators" },
    { "include": "#namespace" },
    { "include": "#function-call" },
    { "include": "#property-access" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.zak",
      "match": "#.*$"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zak",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.zak", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.zak",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "language-constants": {
      "name": "constant.language.zak",
      "match": "\\b(true|false|nil)\\b"
    },
    "storage-keywords": {
      "name": "storage.type.zak",
      "match": "\\b(let|const|function)\\b"
    },
    "control-keywords": {
      "name": "keyword.control.zak",
      "match": "\\b(if|else|end|while|for|in|break|continue|return)\\b"
    },
    "word-operators": {
      "name": "keyword.operator.word.zak",
      "match": "\\b(and|or|not)\\b"
    },
    "namespace": {
      "name": "entity.name.type.zak",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b(?=\\s*\\.)"
    },
    "function-call": {
      "name": "entity.name.function.zak",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\??\\b(?=\\s*\\()"
    },
    "property-access": {
      "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*\\??)",
      "captures": {
        "1": { "name": "punctuation.accessor.zak" },
        "2": { "name": "variable.other.property.zak" }
      }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.string.zak", "match": "\\+\\+" },
        { "name": "keyword.operator.arithmetic.zak", "match": "//" },
        { "name": "keyword.operator.comparison.zak", "match": "!=" },
        { "name": "keyword.operator.comparison.zak", "match": "==" },
        { "name": "keyword.operator.comparison.zak", "match": ">=" },
        { "name": "keyword.operator.comparison.zak", "match": "<=" },
        { "name": "keyword.operator.arithmetic.zak", "match": "[+\\-*/]" },
        { "name": "keyword.operator.comparison.zak", "match": "[<>]" },
        { "name": "keyword.operator.assignment.zak", "match": "=" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.block.begin.zak", "match": "\\{" },
        { "name": "punctuation.section.block.end.zak", "match": "\\}" },
        { "name": "punctuation.section.brackets.begin.zak", "match": "\\[" },
        { "name": "punctuation.section.brackets.end.zak", "match": "\\]" },
        { "name": "punctuation.section.parens.begin.zak", "match": "\\(" },
        { "name": "punctuation.section.parens.end.zak", "match": "\\)" },
        { "name": "punctuation.separator.comma.zak", "match": "," },
        { "name": "punctuation.separator.colon.zak", "match": ":" },
        { "name": "punctuation.accessor.zak", "match": "\\." }
      ]
    },
    "identifiers": {
      "name": "variable.other.readwrite.zak",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\??\\b"
    }
  }
}
